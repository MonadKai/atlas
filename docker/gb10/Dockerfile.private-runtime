# SPDX-License-Identifier: AGPL-3.0-only
# Offline packaging only. deploy/release/build.py compiles the actual fixed
# source and creates this complete context in a separate, explicit operation.
FROM ubuntu:24.04@sha256:b35f8c42edf2f1c13abcb5434d8c2034a3f174a517cf0ca71ff3a1acb8a23640
ARG ATLAS_SOURCE_REVISION
ARG ATLAS_VERSION
ARG ATLAS_BINARY_SHA256
LABEL org.opencontainers.image.title="Atlas private GB10 Qwen3.6 NVFP4" \
      org.opencontainers.image.source="https://github.com/MonadKai/atlas" \
      org.opencontainers.image.revision="${ATLAS_SOURCE_REVISION}" \
      org.opencontainers.image.version="${ATLAS_VERSION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      cn.100credit.atlas.binary-sha256="${ATLAS_BINARY_SHA256}" \
      cn.100credit.atlas.kernel-target="gb10/qwen3.6-35b-a3b/nvfp4/sm_121f" \
      cn.100credit.atlas.validation-scope="private single-model development; not upstream matrix or production qualification"
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    LD_LIBRARY_PATH=/opt/atlas/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
COPY runtime/ /opt/atlas/lib/
COPY spark /usr/local/bin/spark
COPY jinja-templates/ /opt/atlas/jinja-templates/
COPY MODEL.toml /opt/atlas/MODEL.toml
COPY LICENSE /opt/atlas/LICENSE
COPY notices/ /opt/atlas/notices/
COPY source.tar.gz /opt/atlas/source/
COPY build-input-lock.json build-receipt.json runtime-manifest.json /opt/atlas/
RUN test "${#ATLAS_SOURCE_REVISION}" -eq 40 && \
    test -n "${ATLAS_VERSION}" && \
    test "${#ATLAS_BINARY_SHA256}" -eq 64 && \
    test "$(sha256sum /usr/local/bin/spark | cut -d ' ' -f 1)" = "${ATLAS_BINARY_SHA256}"
WORKDIR /opt/atlas
ENTRYPOINT ["/usr/local/bin/spark"]
CMD ["--help"]
